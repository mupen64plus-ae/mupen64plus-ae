@@ -30,6 +31,12 @@ public class InputManager {
     private TouchscreenJoystick touchscreenJoystick;
     private boolean useTouchscreenJoystick = true;

+    private GyroscopeInputMapper gyroscopeMapper;
+    private final CoroutineScope uiScope = CoroutineScope(Dispatchers.Main);
+    private Job gyroJob;
+
+    public void setGyroscopeMapper(GyroscopeInputMapper mapper) {
+        this.gyroscopeMapper = mapper;
+    }

     public void updateGamepadState() {
         // ... existing code ...
@@ -120,6 +127,20 @@ public class InputManager {
         // ... existing joystick handling ...
     }

+    private void updateGyroscopeInput() {
+        if (gyroscopeMapper == null) return;
+        if (gyroJob != null) gyroJob.cancel();
+        gyroJob = uiScope.launch {
+            gyroscopeMapper.joystickX.collectLatest { x ->
+                if (Math.abs(x) > 0.05f) {
+                    // Sobrescribe eje X del joystick virtual (izq/der)
+                    setVirtualJoystickX(x);
+                }
+            }
+            gyroscopeMapper.joystickY.collectLatest { y ->
+                if (Math.abs(y) > 0.05f) {
+                    // Sobrescribe eje Y del joystick virtual (arriba/abajo)
+                    setVirtualJoystickY(y);
+                }
+            }
+        };
+    }
+
     // ... métodos existentes setVirtualJoystickX, setVirtualJoystickY, etc.

diff --git a/app/src/main/java/org/mupen64plus/ae/v3/preference/PreferencesFragment.java b/app/src/main/java/org/mupen64plus/ae/v3/preference/PreferencesFragment.java
index p3q4r5s..t6u7v8w 100644
--- a/app/src/main/java/org/mupen64plus/ae/v3/preference/PreferencesFragment.java
+++ b/app/src/main/java/org/mupen64plus/ae/v3/preference/PreferencesFragment.java
@@ -45,6 +45,14 @@ public class PreferencesFragment extends PreferenceFragmentCompat {
         // ... existing preferences ...

+        // Giroscopio para juegos de carreras
+        SwitchPreferenceCompat gyroPref = findPreference("gyro_enabled");
+        if (gyroPref != null) {
+            gyroPref.setOnPreferenceChangeListener((preference, newValue) -> {
+                boolean enabled = (Boolean) newValue;
+                SharedPreferences prefs = PreferenceManager.getDefaultSharedPreferences(requireContext());
+                prefs.edit().putBoolean("gyro_enabled", enabled).apply();
+                // Notificar a GameActivity si está activa
+                EventBus.getDefault().post(new GyroSettingChangedEvent(enabled));
+                return true;
+            });
+        }
+
         // ... resto de preferencias
     }

